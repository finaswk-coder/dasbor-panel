# ===== Discord =====
DISCORD_TOKEN=isi_token_bot_discord

# ===== Roblox (milik pemilik bot) =====
# Dipakai untuk .rbxm (user TIDAK perlu API key) dan sebagai cadangan download di .spoff.
# Permission yang wajib: Legacy Assets -> legacy-asset:manage
BOT_ROBLOX_API_KEY=

# ===== Keamanan =====
# String acak panjang (min 32 karakter). Dipakai untuk enkripsi API key user di data/keys.json
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=

# ===== Batas =====
MAX_IDS_PER_COMMAND=25

# Prefix command
PREFIX=.

# Channel yang boleh (pisah koma). Kosong = semua channel. DM selalu boleh.
ALLOWED_CHANNEL_IDS=
